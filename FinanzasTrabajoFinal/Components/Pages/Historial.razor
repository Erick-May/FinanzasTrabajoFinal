@page "/historial"
@rendermode InteractiveServer
@using FinanzasTrabajoFinal.MODELS
@using FinanzasTrabajoFinal.Data
@using FinanzasTrabajoFinal.Service
@using Microsoft.EntityFrameworkCore
@using System.Globalization

@inject IDbContextFactory<FinanzasContext> DbFactory
@inject UserStateService UserState
@inject NavigationManager NavManager

<PageTitle>Historial de Análisis</PageTitle>

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-clock-history me-2"></i>Historial de Análisis</h2>
        <a href="upload" class="btn btn-outline-primary">
            <i class="bi bi-plus-lg"></i> Nuevo Análisis
        </a>
    </div>

    @if (listaAnalisis == null)
    {
        <div class="text-center p-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Cargando...</span>
            </div>
        </div>
    }
    else if (!listaAnalisis.Any())
    {
        <div class="alert alert-info text-center shadow-sm">
            <h4><i class="bi bi-folder2-open"></i> No tienes análisis guardados</h4>
            <p>Sube un archivo Excel para comenzar tu primer análisis financiero.</p>
            <a href="upload" class="btn btn-primary mt-2">Ir a Cargar</a>
        </div>
    }
    else
    {
        <div class="card shadow-sm">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0 align-middle">
                        <thead class="table-light">
                            <tr>
                                <th scope="col" class="ps-4">Fecha</th>
                                <th scope="col">Archivo</th>
                                <th scope="col" class="text-end pe-4">Acción</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in listaAnalisis)
                            {
                                <tr @onclick="() => VerResultados(item.IdAnalisis)" class="fila-historial" title="Ver resultados de este análisis">
                                    <td class="ps-4">
                                        <div class="fw-bold text-dark">@item.FechaAnalisis.ToString("dd MMM yyyy", new CultureInfo("es-ES"))</div>
                                        <div class="small text-muted">@item.FechaAnalisis.ToString("hh:mm tt")</div>
                                    </td>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <div class="rounded p-2 bg-light me-3 border">
                                                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="#198754" class="bi bi-file-earmark-spreadsheet-fill" viewBox="0 0 16 16">
                                                    <path d="M6 12v-2h3v2H6z" />
                                                    <path d="M9.293 0H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2V4.707A1 1 0 0 0 13.707 4L10 0.293A1 1 0 0 0 9.293 0M9.5 3.5v-2l3 3h-2a1 1 0 0 1-1-1M3 9h10v1h-3v2h3v1h-3v2H9v-2H6v2H5v-2H3v-1h2v-2H3V9z" />
                                                </svg>
                                            </div>
                                            <span class="fw-medium">@item.NombreArchivo</span>
                                        </div>
                                    </td>
                                    <td class="text-end pe-4">
                                        <button class="btn btn-sm btn-outline-secondary">
                                            Ver Resultados <i class="bi bi-chevron-right ms-1"></i>
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
</div>

<style>
    .fila-historial {
        cursor: pointer;
        transition: background-color 0.2s ease;
    }

        .fila-historial:hover {
            background-color: #f8f9fa; /* Color gris muy clarito al pasar el mouse */
        }
</style>

@code {
    private List<AnalisisFinanciero>? listaAnalisis;

    protected override async Task OnInitializedAsync()
    {
        // Verificar login
        if (!UserState.IsLoggedIn || UserState.CurrentUser == null)
        {
            NavManager.NavigateTo("/login");
            return;
        }

        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();

            // CONSULTA BD: Obtener análisis SOLO del usuario actual, del más nuevo al más viejo
            listaAnalisis = await db.AnalisisFinancieros
                .Where(a => a.IdUsuario == UserState.CurrentUser.IdUsuario)
                .OrderByDescending(a => a.FechaAnalisis)
                .ToListAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error cargando historial: {ex.Message}");
            listaAnalisis = new List<AnalisisFinanciero>();
        }
    }

    private void VerResultados(int idAnalisis)
    {
        // Aquí sucede la magia: Navegamos a la página de Resultados pasándole el ID
        NavManager.NavigateTo($"/resultados/{idAnalisis}");
    }
}