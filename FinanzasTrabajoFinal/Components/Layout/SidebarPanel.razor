@code {
    private bool isCollapsed = false;

    private async Task ToggleSidebar()
    {
        isCollapsed = !isCollapsed;
        await UpdateMainContentPadding();
    }

    private async Task UpdateMainContentPadding()
    {
        try
        {
            var padding = !isCollapsed ? 280 : 70;
            await JSRuntime.InvokeVoidAsync("eval", $"document.querySelector('.main-content-with-sidebar').style.paddingLeft = '{padding}px';");
        }
        catch
        {
            // Ignorar errores de JS si el DOM no está listo
        }
    }

    private async Task NavigateToAnalysis(string tabId)
    {
        if (!UserStateService.IsLoggedIn)
        {
            NavigationManager.NavigateTo("/login");
            return;
        }

        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();

            // Buscar el análisis más reciente del usuario actual
            var ultimoAnalisis = await db.AnalisisFinancieros
                .Where(a => a.IdUsuario == UserStateService.CurrentUser.IdUsuario)
                .OrderByDescending(a => a.FechaAnalisis)
                .FirstOrDefaultAsync();

            if (ultimoAnalisis != null)
            {
                // Navegar al análisis con el tab específico
                NavigationManager.NavigateTo($"/resultados/{ultimoAnalisis.IdAnalisis}?tab={tabId}");
            }
            else
            {
                // Si no tiene análisis, llevarlo a cargar archivo
                NavigationManager.NavigateTo("/upload");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al navegar al análisis: {ex.Message}");
            NavigationManager.NavigateTo("/upload");
        }
    }

    protected override async Task OnInitializedAsync()
    {
        UserStateService.OnChange += HandleUserStateChange;
        await UpdateMainContentPadding();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await UpdateMainContentPadding();
        }
    }

    private async void HandleUserStateChange()
    {
        try
        {
            await InvokeAsync(StateHasChanged);
        }
        catch (ObjectDisposedException) { }
        catch (Exception ex)
        {
            Console.WriteLine($"Error en HandleUserStateChange: {ex.Message}");
        }
    }

    public void Dispose()
    {
        UserStateService.OnChange -= HandleUserStateChange;
    }
}