</div>

<style>
    .sidebar-panel {
        position: fixed;
        left: 0;
        top: 64px;
        height: calc(100vh - 64px);
        width: 280px;
        background: linear-gradient(180deg, rgba(173, 216, 230, 0.95) 0%, rgba(135, 206, 250, 0.95) 100%);
        backdrop-filter: blur(10px);
        border-right: 1px solid rgba(255, 255, 255, 0.3);
        box-shadow: 2px 0 15px rgba(135, 206, 235, 0.2);
        z-index: 1000;
        transition: transform 0.4s cubic-bezier(0.4, 0, 0.2, 1), width 0.4s cubic-bezier(0.4, 0, 0.2, 1);
        overflow-y: auto;
        overflow-x: hidden;
        display: flex;
        flex-direction: column;
        animation: slideInLeft 0.5s ease-out;
    }

    @@keyframes slideInLeft {
        from {
            transform: translateX(-100%);
            opacity: 0;
        }

        to {
            transform: translateX(0);
            opacity: 1;
        }
    }

    .sidebar-panel.collapsed {
        width: 70px;
    }


    .sidebar-header {
        padding: 1rem;
        border-bottom: 1px solid rgba(255, 255, 255, 0.3);
        display: flex;
        align-items: center;
        gap: 0.75rem;
        background: rgba(255, 255, 255, 0.2);
    }

    .sidebar-toggle {
        background: rgba(255, 255, 255, 0.3);
        border: 1px solid rgba(255, 255, 255, 0.4);
        border-radius: 8px;
        padding: 0.5rem;
        cursor: pointer;
        color: #0b2540;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        flex-shrink: 0;
    }

        .sidebar-toggle:hover {
            background: rgba(255, 255, 255, 0.5);
            transform: scale(1.1) rotate(90deg);
            box-shadow: 0 4px 12px rgba(135, 206, 235, 0.3);
        }

        .sidebar-toggle:active {
            transform: scale(0.95);
        }

    .sidebar-title {
        font-size: 1.1rem;
        font-weight: 700;
        color: #0b2540;
        margin: 0;
        white-space: nowrap;
    }

    .sidebar-panel.collapsed .sidebar-title {
        display: none;
    }

    .sidebar-nav {
        flex: 1;
        padding: 1rem 0;
        display: flex;
        flex-direction: column;
        overflow-y: auto;
    }

    .nav-section {
        padding: 0 1rem;
        margin-bottom: 1.5rem;
    }

    .nav-section-title {
        font-size: 0.75rem;
        font-weight: 600;
        color: rgba(11, 37, 64, 0.7);
        text-transform: uppercase;
        letter-spacing: 0.5px;
        margin-bottom: 0.5rem;
        padding-left: 0.5rem;
    }

    .sidebar-panel.collapsed .nav-section-title {
        display: none;
    }

    .nav-link {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        padding: 0.75rem 1rem;
        color: #0b2540;
        text-decoration: none;
        border-radius: 10px;
        margin-bottom: 0.25rem;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        font-weight: 500;
        background: rgba(255, 255, 255, 0.2);
        border: 1px solid transparent;
        cursor: pointer;
        position: relative;
        overflow: hidden;
    }

        .nav-link::before {
            content: '';
            position: absolute;
            top: 0;
            left: -100%;
            width: 100%;
            height: 100%;
            background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.3), transparent);
            transition: left 0.5s ease;
        }

        .nav-link:hover::before {
            left: 100%;
        }

        .nav-link:hover {
            background: rgba(255, 255, 255, 0.4);
            transform: translateX(6px) scale(1.02);
            border-color: rgba(255, 255, 255, 0.6);
            box-shadow: 0 4px 12px rgba(135, 206, 235, 0.2);
        }

        .nav-link:active {
            transform: translateX(4px) scale(0.98);
        }

    .nav-link-icon-only {
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 0.75rem;
        color: #0b2540;
        text-decoration: none;
        border-radius: 10px;
        margin: 0.25rem auto;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        width: 45px;
        height: 45px;
        background: rgba(255, 255, 255, 0.2);
        border: 1px solid transparent;
        cursor: pointer;
        position: relative;
        overflow: hidden;
    }

        .nav-link-icon-only::before {
            content: '';
            position: absolute;
            top: 50%;
            left: 50%;
            width: 0;
            height: 0;
            border-radius: 50%;
            background: rgba(255, 255, 255, 0.3);
            transform: translate(-50%, -50%);
            transition: width 0.3s ease, height 0.3s ease;
        }

        .nav-link-icon-only:hover::before {
            width: 100%;
            height: 100%;
        }

        .nav-link-icon-only:hover {
            background: rgba(255, 255, 255, 0.4);
            transform: scale(1.15) rotate(5deg);
            border-color: rgba(255, 255, 255, 0.6);
            box-shadow: 0 4px 12px rgba(135, 206, 235, 0.25);
        }

        .nav-link-icon-only:active {
            transform: scale(1.05) rotate(0deg);
        }

    .nav-icon {
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        width: 20px;
        height: 20px;
        color: currentColor;
    }

        .nav-icon svg {
            width: 100%;
            height: 100%;
        }

    .nav-text {
        white-space: nowrap;
        overflow: hidden;
    }

    .sidebar-panel.collapsed .nav-text {
        display: none;
    }

    .mt-auto {
        margin-top: auto;
    }

    @@media (max-width: 768px) {
        .sidebar-panel {
            transform: translateX(-100%);
            width: 280px;
        }

            .sidebar-panel:not(.collapsed) {
                transform: translateX(0);
            }

            .sidebar-panel.collapsed {
                transform: translateX(-100%);
            }
    }

    /* Scrollbar styling */
    .sidebar-panel::-webkit-scrollbar {
        width: 6px;
    }

    .sidebar-panel::-webkit-scrollbar-track {
